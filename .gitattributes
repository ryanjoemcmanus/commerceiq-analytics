* text=auto

*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Generated notebook previews are deliverables, not source language.
reports/notebooks/*.html linguist-generated=true

# Reflect the project's authored analytical languages in GitHub statistics.
*.ipynb linguist-language=Python
*.sql linguist-detectable=true

