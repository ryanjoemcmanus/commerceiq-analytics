# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# IDE and editor files
.vscode/
.idea/
*.code-workspace
*.swp
*~

# Operating-system files
.DS_Store
Thumbs.db

# Source and generated datasets (retain directory placeholders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated reports and temporary outputs
reports/*
!reports/.gitkeep
!reports/README.md
output/
outputs/
tmp/
temp/
*.log
